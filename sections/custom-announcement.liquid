<div class="custom-announcement" style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};">
    <p>{{ section.settings.announcement_text | escape }}</p> 

</div>

{% style %}
    .custom-announcement {
        color: #ffffff;
        text-align: center;
        padding: 12px 16px;
    }

    .custom-announcement p {
        margin: 0;
    }

{% endstyle %}

{% schema %}
    {
    "name": "Custom announcement",
    "settings": [
        {
            "type": "text",
            "id": "announcement_text",
            "label": "Announcement Text",
            "default": "Free shipping on orders above ₹999"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#004C3F"

        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#ffffff"
        }
        ],
        
        "presets": [
            { "name": "Custom announcement"}
        ]
    
    }
{% endschema %}